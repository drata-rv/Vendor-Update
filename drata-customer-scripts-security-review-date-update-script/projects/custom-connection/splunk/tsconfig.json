{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2020",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./src/",
        "incremental": true,
        "esModuleInterop": true,
        "inlineSources": true,
        "skipLibCheck": true
    },
    "exclude": [
        "node_modules",
        "dist",
        "coverage",
        "documentation",
        "docs",
        "src/scripts/archived"
    ],
    "include": ["src/**/*", "config", ".eslintrc.js"],
    "ts-node": {
        "transpileOnly": true
    }
}
